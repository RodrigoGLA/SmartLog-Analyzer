# App
PORT=3000

# Conexión a Postgres desde la app (corre local con `npm run start:dev`, no en Docker todavía).
# Si el servicio `db` de docker-compose.yml corriera dentro de la misma red que la app, el host
# sería `db` en vez de `localhost` — ver decisión #16 en ARCHITECTURE.md.
DATABASE_URL=postgresql://smartlog:smartlog@localhost:5432/smartlog

# Credenciales del servicio `db` en docker-compose.yml (imagen oficial de postgres).
# Deben coincidir con el usuario/password/db embebidos en DATABASE_URL.
POSTGRES_USER=smartlog
POSTGRES_PASSWORD=smartlog
POSTGRES_DB=smartlog

# pg-boss (cola de análisis) reutiliza esta misma DATABASE_URL, en su propio schema ("pgboss",
# creado automáticamente al arrancar) — no necesita variable propia.

# Worker de análisis (src/analysis/), usadas desde la Etapa 4. Con MockLlmProvider (el único
# provider de esta etapa) no hace falta tocarlas; quedan los defaults de env.schema.ts.
LLM_TIMEOUT_MS=20000
ANALYSIS_MAX_PATTERNS=50
ANALYSIS_MAX_RANGE_HOURS=168

# --- No usadas todavía por ningún código: Etapa 5 (GeminiLlmProvider) ---
# LLM_PROVIDER=mock
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash
